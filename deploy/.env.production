# Flask
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
FLASK_DEBUG=0
DATABASE_URL=mysql+pymysql://flask_assets_user:CHANGE_ME_PASSWORD@localhost/flask_assets_db

# SSO (set to true to enable)
SSO_ENABLED=false
SSO_PROVIDER=

# Okta (if using Okta SSO)
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_DOMAIN=
OKTA_AUTH_SERVER=default

# Entra ID (if using Microsoft SSO)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
