# Flask
SECRET_KEY=your-secret-key-here
FLASK_DEBUG=0
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/it_asset_manager

# SSO (set SSO_ENABLED=true to enable)
SSO_ENABLED=false
SSO_PROVIDER=okta

# Okta
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_DOMAIN=yourorg.okta.com
OKTA_AUTH_SERVER=default

# Entra ID (Azure AD)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
